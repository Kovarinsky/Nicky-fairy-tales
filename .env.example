# ── Zkopíruj tento soubor jako .env.local a doplň skutečné klíče ──
# (.env.local je v .gitignore, takže se nikdy nezacommituje)

# Claude – generování příběhu
# https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini "Nano Banana" – generování ilustrací
# https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIza...

# ElevenLabs – namluvení (text-to-speech)
# https://elevenlabs.io → Profile → API key
ELEVENLABS_API_KEY=...

# ── Volitelná konfigurace (rozumné defaulty jsou v kódu) ──

# Model Claude pro psaní pohádek
ANTHROPIC_MODEL=claude-opus-4-8

# Gemini model pro obrázky (Nano Banana)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Český hlas z ElevenLabs Voice Library (Voice ID)
# Vyber hlas na https://elevenlabs.io/app/voice-library a vlož jeho ID
ELEVENLABS_VOICE_ID=
# Model TTS — flash_v2_5 umí česky za poloviční cenu než multilingual_v2
# (ověřeno A/B poslechem 2026-08-06, viz ECONOMY-PLAN.md); v3 je
# expresivnější/dražší, multilingual_v2 je konzervativnější/dražší volba
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# 💰 Měsíční strop appčiny VLASTNÍ (Gemini-only) útraty za ilustrace, v USD.
# Nenastaveno = appka nemá žádný strop (chová se jako dřív). Jakmile appčino
# vlastní měření od začátku kalendářního měsíce (lib/usage.ts) dosáhne téhle
# hodnoty, /api/job/start nové pohádky odmítne (fail-open: výpadek vlastního
# měření pohádku nezablokuje). Cíl: appka zastaví PŘED tím, než narazí na
# Googlein měsíční limit automatického navyšování zůstatku v AI Studiu —
# doporučeno nastavit o pár desítek % níž, než je tenhle skutečný GCP strop.
# MONTHLY_SPEND_CAP_USD=180
